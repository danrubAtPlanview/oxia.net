{
  "name": "cpu",
  "description": "Client CPU per operation: the scenarios in which the .NET client used more CPU than the Go client (C sync, F no batching, G open loop), each also with the .NET thread pool spin-wait switched off (DOTNET_ThreadPool_UnfairSemaphoreSpinLimit=0, docs/performance.md section 11). 3 repetitions, alternating order. ~30 minutes including create and delete.",
  "defaults": {
    "client": "async", "ops": "put,get", "readPercent": 50, "keyCount": 100000, "valueSize": 128, "producers": 256,
    "linger": "5ms", "maxRequestsPerBatch": 1000, "shards": 1, "serverSync": false, "notifications": true,
    "durationSec": 15, "warmupSec": 3, "runs": 3
  },
  "scenarios": [
    { "id": "C", "name": "sync client, 64 callers, put+get 50/50", "client": "sync", "producers": 64 },
    { "id": "C-spin0", "name": "sync client, 64 callers, put+get 50/50", "client": "sync", "producers": 64,
      "variantOf": "C", "variantLabel": "spin limit 0", "impls": ["dotnet"], "dotnetEnv": "DOTNET_ThreadPool_UnfairSemaphoreSpinLimit=0" },
    { "id": "F", "name": "async, 64 producers, put+get, linger 0 (no batching)", "producers": 64, "linger": "0ms" },
    { "id": "F-spin0", "name": "async, 64 producers, put+get, linger 0 (no batching)", "producers": 64, "linger": "0ms",
      "variantOf": "F", "variantLabel": "spin limit 0", "impls": ["dotnet"], "dotnetEnv": "DOTNET_ThreadPool_UnfairSemaphoreSpinLimit=0" },
    { "id": "G", "name": "async, open loop 20k ops/s, put+get (latency under fixed load)", "rate": 20000, "producers": 256 },
    { "id": "G-spin0", "name": "async, open loop 20k ops/s, put+get (latency under fixed load)", "rate": 20000, "producers": 256,
      "variantOf": "G", "variantLabel": "spin limit 0", "impls": ["dotnet"], "dotnetEnv": "DOTNET_ThreadPool_UnfairSemaphoreSpinLimit=0" }
  ]
}
