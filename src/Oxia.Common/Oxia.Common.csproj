<Project Sdk="Microsoft.NET.Sdk">
  <!-- Port of github.com/oxia-db/oxia/common (client-relevant subset). See PORTING.md. -->
  <PropertyGroup>
    <RootNamespace>Oxia.Common</RootNamespace>
    <AssemblyName>Oxia.Common</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Grpc.Core.Api" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.StatusProto" />
    <PackageReference Include="Grpc.HealthCheck" />
    <PackageReference Include="System.IO.Hashing" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- Verbatim copies of upstream protos (sync = copy files over). Messages are generated by protoc for the
         cold paths (admin) and as the wire-format oracle for tests; the hot-path client messages are hand-written
         in Oxia.Common.Proto (zero-allocation codecs). -->
    <Protobuf Include="Proto\client.proto" ProtoRoot="Proto" GrpcServices="Both" />
    <Protobuf Include="Proto\replication.proto" ProtoRoot="Proto" GrpcServices="None" />
    <Protobuf Include="Proto\metadata.proto" ProtoRoot="Proto" GrpcServices="None" />
    <Protobuf Include="Proto\admin.proto" ProtoRoot="Proto" GrpcServices="Client" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Oxia.Client" />
    <InternalsVisibleTo Include="Oxia.Client.Tests" />
    <InternalsVisibleTo Include="Oxia.Client.IntegrationTests" />
    <InternalsVisibleTo Include="Oxia.TestSupport" />
    <InternalsVisibleTo Include="Oxia.Client.Benchmarks" />
  </ItemGroup>
</Project>
