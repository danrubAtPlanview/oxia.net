<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Oxia.Client.Tests</RootNamespace>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
    <!-- Directory.Build.props turns TieredPGO on for the product and the benchmarks.  The allocation-budget tests (Alloc/) measure the steady state of
         optimised code, and the instrumented PGO tier allocates extra (probe data, delegate/type guards) for as long as a method sits in it. On a
         small or busy machine (a 4-vCPU CI runner) the background JIT needs seconds to get the hot paths out of that tier, longer than any fixed warm-up,
         which showed as 90-150 B/op instead of 5-16 B/op.  Without the instrumented tier a hot method goes from tier 0 to tier 1 directly.  Optimised
         code with PGO never allocates MORE than the code without it, so the budgets stay conservative. -->
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <ProjectReference Include="..\..\src\Oxia.Common\Oxia.Common.csproj" />
    <ProjectReference Include="..\..\src\Oxia.Client\Oxia.Client.csproj" />
    <ProjectReference Include="..\Oxia.TestSupport\Oxia.TestSupport.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- the latency histogram of the load generator (benchmarks/Oxia.Client.Benchmarks/Load) is tested here without referencing BenchmarkDotNet -->
    <Compile Include="..\..\benchmarks\Oxia.Client.Benchmarks\Load\LatencyHistogram.cs" Link="Throughput\LatencyHistogram.Linked.cs" />
  </ItemGroup>
</Project>
